{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mycloud-gui",
  "version": "0.1.0",
  "identifier": "com.mycloud.gui",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AkSync",
        "width": 860,
        "height": 580,
        "minWidth": 740,
        "minHeight": 500,
        "resizable": true,
        "visible": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "AkSync — Şifreli Bulut Sürücüsü"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
